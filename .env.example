# Copie para .env e preencha (opcional).

# Aviso da equipe no Microsoft Teams ou Slack:
# cole aqui o link de entrada do canal (Teams: "Workflows/Webhook de entrada"; Slack: "Incoming Webhook")
LINK_AVISO_EQUIPE=

# Modelos YOLOv8 (baixados automaticamente na primeira execução)
YOLO_DET_MODEL=yolov8n.pt
YOLO_POSE_MODEL=yolov8n-pose.pt
